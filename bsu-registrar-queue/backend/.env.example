# Database
DATABASE_URL=postgresql://postgres:password@localhost/bsu_queue

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS - comma-separated list of origins allowed to call the API.
# In production, set this to your deployed frontend's real domain(s).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Application
# DEBUG must be False in production - it also controls whether /docs,
# /redoc, and /openapi.json are exposed.
DEBUG=True
LOG_LEVEL=info
